# MERCIA — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────

# Port for local development (Vercel ignores this)
PORT=3000

# Runtime environment: "development" | "production"
NODE_ENV=development

# ─────────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────────

# LOCAL:      mongodb://127.0.0.1:27017/mercia
# PRODUCTION: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mercia?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mercia

# ─────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────

# Must be a long, random, secret string in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Token expiry (e.g. 7d, 24h, 30d)
JWT_EXPIRE=7d

# ─────────────────────────────────────────────────
# CORS (Production only)
# ─────────────────────────────────────────────────

# Comma-separated list of allowed origins.
# Set this in Vercel's Environment Variables panel to your deployed URL.
# Example: https://mercia.vercel.app
# Leave UNSET in development to allow all origins.
CORS_ORIGIN=https://your-project-name.vercel.app

# ─────────────────────────────────────────────────
# Admin Seeder (used by `npm run seed` locally or on Atlas)
# ─────────────────────────────────────────────────

ADMIN_USERNAME=Master0015
ADMIN_EMAIL=master@mercia.com
ADMIN_PASSWORD=Master@015
